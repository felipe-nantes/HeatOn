---
import { team } from '../content/site';
---

<section id="time" class="section surface-cream" aria-labelledby="team-title">
  <div class="container section-content">
    <p class="data reveal reveal--label">{team.label}</p>
    <h2 id="team-title" class="h1 reveal reveal--title">{team.headline}</h2>
    <p class="body-copy team-lede reveal reveal--body">{team.body}</p>

    <ol role="list" class="team-grid">
      {
        team.members.map((m) => (
          <li class="member reveal reveal--body">
            <a class="member-photo-link" href={`/time/${m.id}`} aria-label={`Perfil de ${m.shortName}`}>
              <figure class="member-figure">
                <img
                  src={m.photo}
                  alt={m.alt}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </a>
            <p class="data member-num">{m.num}</p>
            <h3 class="member-name">{m.shortName}</h3>
            <p class="member-role">{m.role}</p>
            <p class="data member-discipline">{m.discipline}</p>
            <a class="seq-full-link member-link" href={`/time/${m.id}`}>
              VER PERFIL +
            </a>
          </li>
        ))
      }
    </ol>

    <a class="pill section-cta" href="/time">
      Conhecer o time
      <span class="pill-plus" aria-hidden="true">+</span>
    </a>
  </div>
</section>

<style>
  .section-cta {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .team-lede {
    margin-top: 1.25rem;
  }

  .team-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .member {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .member-figure {
    margin: 0 0 1.25rem;
    overflow: hidden;
    background: rgba(14, 14, 16, 0.06);
  }

  .member-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Retrato em escala de cinza; o calor entra só no elemento ativo */
    filter: grayscale(1) contrast(1.04);
    transition:
      filter var(--motion-base) var(--ease-editorial),
      transform var(--motion-base) var(--ease-editorial);
  }

  .member-photo-link {
    display: block;
  }

  @media (hover: hover) {
    .member:hover .member-figure img,
    .member-photo-link:focus-visible .member-figure img {
      filter: grayscale(0) contrast(1);
      transform: scale(1.02);
    }
  }

  .member-num {
    padding-top: 0.9rem;
    border-top: 1px solid rgba(14, 14, 16, 0.16);
    opacity: 0.5;
    transition: color var(--motion-fast) var(--ease-feedback);
  }

  /* Um único elemento ativo por vez */
  @media (hover: hover) {
    .member:hover .member-num {
      color: var(--color-activity);
      opacity: 1;
    }
  }

  .member-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.15rem + 1vw, 1.875rem);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
  }

  .member-role {
    opacity: 0.8;
  }

  .member-link {
    justify-self: start;
    margin-top: 0.6rem;
  }

  .member-discipline {
    margin-top: 0.35rem;
    color: var(--color-measurement);
    opacity: 0.9;
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .member-figure img {
      transition: none;
    }

    .member:hover .member-figure img {
      transform: none;
    }
  }
</style>
