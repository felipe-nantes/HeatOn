---
import { nav } from '../content/site';

interface Props {
  /** Páginas internas não têm hero em vídeo: o header já nasce com superfície. */
  solid?: boolean;
}

const { solid = false } = Astro.props;
---

<header id="site-header" class:list={['site-header', { 'is-solid': solid }]}>
  <div class="header-inner">
    <a class="brand" href="#hero" aria-label="Heat On — voltar ao início">
      <img
        class="brand-logo"
        src="/assets/brand/logo-horizontal-cream.svg"
        alt="Heat On"
        width="150"
        height="26"
      />
      <img
        class="brand-symbol"
        src="/assets/brand/symbol-cream.svg"
        alt="Heat On"
        width="52"
        height="28"
      />
    </a>

    <nav class="header-nav" aria-label="Navegação principal">
      <ol role="list" class="nav-row">
        {
          nav.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="nav-num">{item.num}</span>
                <span class="nav-label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p class="header-meta data">
      <span>PAGE: HOME</span>
      <span aria-hidden="true">/</span>
      <span>
        SECTION: <span id="section-indicator" aria-live="polite">INTRO</span>
      </span>
    </p>

    <button
      id="index-toggle"
      class="index-toggle data"
      type="button"
      aria-expanded="false"
      aria-controls="index-overlay"
    >
      {nav.indexLabel}
      <span class="index-plus" aria-hidden="true">+</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    color: var(--color-information);
    background: transparent;
    transition:
      background-color var(--motion-base) var(--ease-feedback),
      box-shadow var(--motion-base) var(--ease-feedback);
  }

  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: currentColor;
    opacity: 0.14;
  }

  .site-header.is-solid,
  .site-header.is-scrolled {
    background: rgba(14, 14, 16, 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* Fora do hero o header enxuga: a nav numerada recolhe e ficam logo,
     indicador de seção e INDEX — que segue dando acesso a tudo.
     visibility (e não só opacity) para sair também da ordem de tabulação. */
  .site-header.is-scrolled .header-nav {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    max-width: var(--layout-max);
    margin-inline: auto;
    padding: 0.8rem var(--page-pad);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-symbol {
    display: none;
  }

  .header-nav {
    display: none;
    transition:
      opacity var(--motion-base) var(--ease-feedback),
      visibility var(--motion-base) var(--ease-feedback),
      transform var(--motion-base) var(--ease-feedback);
  }

  /* Linha única: com 5 itens, empilhar em pares deixaria o último órfão. */
  .nav-row {
    display: flex;
    align-items: center;
  }

  .nav-row li {
    padding-inline: clamp(0.7rem, 1.3vw, 1.4rem);
  }

  .nav-row li + li {
    border-left: 1px solid rgba(255, 244, 230, 0.18);
  }

  .nav-row li:first-child {
    padding-left: 0;
  }

  .nav-row li:last-child {
    padding-right: 0;
  }

  .header-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7em;
    text-decoration: none;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: var(--tracking-data);
    text-transform: uppercase;
    line-height: 1.5;
    white-space: nowrap;
  }

  .nav-num {
    opacity: 0.5;
    transition:
      color var(--motion-fast) var(--ease-feedback),
      opacity var(--motion-fast) var(--ease-feedback);
  }

  /* Um elemento ativo por vez: o número do link em foco/hover */
  .header-nav a:hover .nav-num,
  .header-nav a:focus-visible .nav-num {
    color: var(--color-activity);
    opacity: 1;
  }

  .header-meta {
    display: none;
    margin-left: auto;
    gap: 0.6em;
    opacity: 0.7;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .index-toggle {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.55em 1.1em;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .index-plus {
    display: inline-block;
    font-weight: 500;
    transition:
      transform var(--motion-fast) var(--ease-feedback),
      color var(--motion-fast) var(--ease-feedback);
  }

  .index-toggle:hover .index-plus,
  .index-toggle:focus-visible .index-plus {
    color: var(--color-activity);
  }

  /* O + vira × sem rotacionar o logo ou outros símbolos */
  .index-toggle[aria-expanded='true'] .index-plus {
    transform: rotate(45deg);
  }

  @media (min-width: 768px) {
    .header-meta {
      display: inline-flex;
    }

    .index-toggle {
      margin-left: 0;
    }
  }

  /* Abaixo disso a linha única não caberia junto de logo, PAGE/SECTION
     e INDEX; o header então volta ao formato compacto com o INDEX. */
  @media (min-width: 1280px) {
    .header-nav {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-nav {
      transition: none;
    }

    .site-header.is-scrolled .header-nav {
      transform: none;
    }
  }

  @media (max-width: 479px) {
    .brand-logo {
      display: none;
    }

    .brand-symbol {
      display: block;
    }
  }
</style>
