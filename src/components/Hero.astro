---
import { hero } from '../content/site';

const clipsJson = JSON.stringify(hero.video.clips);
---

<section id="hero" class="hero surface-deep" aria-labelledby="hero-title">
  <div
    class="hero-media"
    id="hero-media"
    aria-hidden="true"
    data-clips={clipsJson}
    data-fallback={hero.video.fallback}
    data-mobile={hero.video.mobile}
    data-poster-mobile={hero.video.posterMobile}
  >
    <picture>
      <source media="(max-width: 767px)" srcset={hero.video.posterMobile} />
      <img
        class="hero-poster"
        src={hero.video.posterDesktop}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      id="hero-video"
      class="hero-video"
      muted
      playsinline
      preload="metadata"
      poster={hero.video.posterDesktop}
      tabindex="-1"
    ></video>
    <video
      id="hero-video-b"
      class="hero-video"
      muted
      playsinline
      preload="none"
      tabindex="-1"
    ></video>
    <div class="hero-scrim"></div>
  </div>

  <!-- Microcopy única, centralizada, com traço técnico -->
  <div class="hero-center">
    <h1 id="hero-title" class="hero-microcopy">
      <span class="visually-hidden">Heat On — {hero.display}. </span>
      <span class="microcopy-text">{hero.support}</span>
      <span class="microcopy-dash" aria-hidden="true"></span>
    </h1>
  </div>

  <!-- Wordmark gigante ancorado na base, escuro translúcido sobre o vídeo -->
  <div class="hero-wordmark" aria-hidden="true">
    <img
      src="/assets/brand/wordmark-deep.svg"
      alt=""
      width="699"
      height="151"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video {
    opacity: 0;
    /* Crossfade único de 250–400 ms na entrada */
    transition: opacity 350ms var(--ease-editorial);
  }

  /* Depois da entrada, as trocas de clipe são cortes secos */
  .hero-video.no-fade {
    transition: none;
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  /* Escurecimento uniforme; base mais clara para o wordmark deep assentar */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(14, 14, 16, 0.5) 0%,
        rgba(14, 14, 16, 0.16) 45%,
        rgba(14, 14, 16, 0.28) 100%
      ),
      rgba(14, 14, 16, 0.22);
  }

  /* ---------- Microcopy central ---------- */
  .hero-center {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    padding: clamp(5rem, 12vh, 7rem) var(--page-pad) clamp(1.5rem, 4vh, 3rem);
  }

  .hero-microcopy {
    display: inline-flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 0.85rem + 0.35vw, 1.125rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.01em;
    text-align: center;
    max-width: 60ch;
    animation: hero-fade 600ms var(--ease-editorial) 250ms both;
  }

  .microcopy-dash {
    flex: none;
    width: clamp(70px, 9vw, 150px);
    border-top: 1px dashed rgba(255, 244, 230, 0.55);
  }

  /* ---------- Wordmark na base, full-bleed ---------- */
  .hero-wordmark {
    position: relative;
    width: 100%;
    padding-inline: clamp(10px, 1.2vw, 28px);
    line-height: 0;
  }

  .hero-wordmark img {
    width: 100%;
    height: auto;
    opacity: 0.82;
    animation: wordmark-rise 700ms var(--ease-editorial) 380ms both;
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes wordmark-rise {
    from {
      opacity: 0;
      transform: translateY(6%);
    }
    to {
      opacity: 0.82;
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .microcopy-dash {
      display: none;
    }

    .hero-microcopy {
      max-width: 34ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-microcopy,
    .hero-wordmark img {
      animation: none;
    }

    .hero-wordmark img {
      opacity: 0.82;
    }
  }
</style>
