---
import { hero } from '../content/site';

const clipsJson = JSON.stringify(hero.video.clips);
---

<section id="hero" class="hero surface-deep" aria-labelledby="hero-title">
  <div
    class="hero-media"
    id="hero-media"
    aria-hidden="true"
    data-clips={clipsJson}
    data-fallback={hero.video.fallback}
    data-mobile={hero.video.mobile}
    data-poster-mobile={hero.video.posterMobile}
  >
    <picture>
      <source media="(max-width: 767px)" srcset={hero.video.posterMobile} />
      <img
        class="hero-poster"
        src={hero.video.posterDesktop}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      id="hero-video"
      class="hero-video"
      muted
      playsinline
      preload="metadata"
      poster={hero.video.posterDesktop}
      tabindex="-1"
    ></video>
    <video
      id="hero-video-b"
      class="hero-video"
      muted
      playsinline
      preload="none"
      tabindex="-1"
    ></video>
    <div class="hero-scrim"></div>
  </div>

  <!-- Wordmark no topo: branco puro + difference = vídeo invertido nas letras -->
  <div class="hero-wordmark" aria-hidden="true">
    <img
      src="/assets/brand/wordmark-white.svg"
      alt=""
      width="699"
      height="151"
      decoding="async"
    />
  </div>

  <div class="container hero-content section-content">
    <p class="data hero-eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title" class="display hero-title">{hero.display}</h1>
    <div class="hero-signal" aria-hidden="true"></div>
    <p class="hero-support body-copy">{hero.support}</p>
    <div class="hero-ctas">
      <a class="pill pill--solid" href={hero.ctaPrimary.href}>
        {hero.ctaPrimary.label}
        <span class="pill-plus" aria-hidden="true">+</span>
      </a>
      <a class="pill" href={hero.ctaSecondary.href}>
        {hero.ctaSecondary.label}
        <span class="pill-plus" aria-hidden="true">+</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Contém o blend do wordmark dentro do hero */
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video {
    opacity: 0;
    /* Crossfade único de 250–400 ms na entrada */
    transition: opacity 350ms var(--ease-editorial);
  }

  /* Depois da entrada, as trocas de clipe são cortes secos */
  .hero-video.no-fade {
    transition: none;
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  /* Filtro mais escuro sobre o vídeo */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(14, 14, 16, 0.55) 0%,
        rgba(14, 14, 16, 0.18) 42%,
        rgba(14, 14, 16, 0.72) 100%
      ),
      rgba(14, 14, 16, 0.24);
  }

  /* ---------- Wordmark no topo, letras invertendo o vídeo ---------- */
  .hero-wordmark {
    position: relative;
    width: 100%;
    max-width: var(--layout-max);
    margin-inline: auto;
    padding: clamp(4.25rem, 10vh, 6rem) var(--page-pad) 0;
  }

  .hero-wordmark img {
    width: 100%;
    height: auto;
    mix-blend-mode: difference;
    animation: hero-in var(--motion-base) var(--ease-editorial) 160ms both;
  }

  .hero-content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(2.5rem, 6vh, 4rem) clamp(3.5rem, 9vh, 5.5rem);
  }

  .hero-eyebrow {
    opacity: 0.72;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    max-width: 14ch;
  }

  /* Linha de sinal: traço fino com o gradiente térmico, percorre 1x */
  .hero-signal {
    height: 2px;
    width: min(360px, 42vw);
    margin-block: clamp(1.5rem, 3.5vh, 2.5rem);
    background: var(--gradient-thermal);
    transform-origin: left center;
  }

  .hero-support {
    max-width: 44ch;
    opacity: 0.86;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 4.5vh, 3rem);
  }

  /* --- Sequência de abertura (~900–1300 ms percebidos) --- */
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes signal-run {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .hero-eyebrow,
  .hero-title,
  .hero-support,
  .hero-ctas {
    animation: hero-in var(--motion-base) var(--ease-editorial) both;
  }

  .hero-eyebrow { animation-delay: 80ms; }
  .hero-title { animation-delay: 240ms; }

  .hero-signal {
    animation: signal-run 480ms var(--ease-editorial) 380ms both;
  }

  .hero-support { animation-delay: 620ms; }
  .hero-ctas { animation-delay: 720ms; }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-support,
    .hero-ctas,
    .hero-wordmark img,
    .hero-signal {
      animation: none;
    }
  }
</style>
