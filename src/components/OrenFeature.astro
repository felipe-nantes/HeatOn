---
import { oren, conceptualCaption } from '../content/site';
---

<section id="oren" class="section surface-deep oren" aria-labelledby="oren-title">
  <div class="container section-content oren-grid">
    <div class="oren-copy">
      <p class="data reveal reveal--label oren-label">{oren.label}</p>
      <h2 id="oren-title" class="display oren-name reveal reveal--title">{oren.title}</h2>
      <p class="h2 reveal reveal--title">{oren.headline}</p>
      <p class="body-copy reveal reveal--body">{oren.body}</p>
      <p class="data oren-meta reveal reveal--body">
        {oren.metadata.join(' / ')}
      </p>
      <a class="pill reveal reveal--body" href={oren.cta.href}>
        {oren.cta.label}
        <span class="pill-plus" aria-hidden="true">+</span>
      </a>
    </div>

    <figure class="oren-figure mask-reveal reveal">
      <picture>
        <source media="(max-width: 767px)" srcset={oren.image.mobile} />
        <img
          src={oren.image.desktop}
          alt={oren.image.alt}
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
          data-parallax="0.03"
        />
      </picture>
      <figcaption class="data figure-caption">{conceptualCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .oren-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .oren-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .oren-label {
    color: var(--color-activity);
  }

  .oren-name {
    letter-spacing: 0.02em;
  }

  .oren-meta {
    opacity: 0.65;
  }

  .oren-figure {
    margin: 0;
  }

  .oren-figure img {
    width: 100%;
    height: auto;
    transition: transform var(--motion-slow) var(--ease-editorial);
  }

  .figure-caption {
    margin-top: 0.9rem;
    opacity: 0.5;
    font-size: 0.6875rem;
  }

  @media (min-width: 1200px) {
    .oren-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
</style>
