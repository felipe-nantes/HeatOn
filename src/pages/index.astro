---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import IndexOverlay from '../components/IndexOverlay.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Territory from '../components/Territory.astro';
import OrenChapter from '../components/OrenChapter.astro';
import FemurChapter from '../components/FemurChapter.astro';
import EfastChapter from '../components/EfastChapter.astro';
import ProjectsIndex from '../components/ProjectsIndex.astro';
import Capabilities from '../components/Capabilities.astro';
import Method from '../components/Method.astro';
import Principles from '../components/Principles.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base>
  <SiteHeader />
  <IndexOverlay />
  <main id="conteudo">
    <Hero />
    <Manifesto />
    <Territory />
    <OrenChapter />
    <FemurChapter />
    <EfastChapter />
    <ProjectsIndex />
    <Capabilities />
    <Method />
    <Principles />
    <Contact />
  </main>
  <SiteFooter />
</Base>
