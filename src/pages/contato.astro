---
import Page from '../layouts/Page.astro';
import { contact } from '../content/site';
---

<Page
  title="Contato — Heat On"
  description={contact.body}
  eyebrow="PAGE 007 / CONTACT"
  heading="Contato"
  headline={contact.headline}
>
  <section class="section surface-deep" aria-label="Formulário de contato">
    <div class="layer layer--contour" aria-hidden="true">
      <img
        class="contour"
        src="/assets/graphics/contour-field.svg"
        alt=""
        width="2400"
        height="1600"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="container section-content contact-grid">
      <div class="contact-copy">
        <p class="body-copy reveal reveal--body">{contact.body}</p>
        <img
          class="signature reveal"
          src="/assets/brand/logo-scientific-signature.svg"
          alt="Heat On — Scientific Intelligence in Motion"
          width="270"
          height="73"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Endpoint, destino e consentimento LGPD pendentes de definição. -->
      <form id="contact-form" class="contact-form reveal reveal--body" novalidate>
        {
          contact.form.fields.map((field) => (
            <div class="form-field">
              <label class="data" for={`campo-${field.id}`}>
                {field.label}
                {field.required && <span aria-hidden="true"> *</span>}
              </label>
              {field.type === 'textarea' ? (
                <textarea
                  id={`campo-${field.id}`}
                  name={field.id}
                  rows={6}
                  required={field.required}
                />
              ) : (
                <input
                  id={`campo-${field.id}`}
                  name={field.id}
                  type={field.type}
                  required={field.required}
                  autocomplete={
                    field.id === 'email'
                      ? 'email'
                      : field.id === 'nome'
                        ? 'name'
                        : 'organization'
                  }
                />
              )}
            </div>
          ))
        }
        <button class="pill contact-submit" type="submit">
          {contact.form.submit}
          <span class="pill-plus" aria-hidden="true">+</span>
        </button>
        <p id="form-status" class="data form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Page>

<style>
  .contour {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .contact-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .signature {
    margin-top: clamp(1.5rem, 4vw, 3rem);
    width: clamp(210px, 22vw, 300px);
    height: auto;
    opacity: 0.92;
  }

  .contact-form {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 560px;
  }

  .form-field {
    display: grid;
    gap: 0.6rem;
  }

  .form-field label {
    opacity: 0.7;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(255, 244, 230, 0.3);
    color: var(--color-information);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.5;
    padding: 0.5rem 0;
    border-radius: 0;
    transition: border-color var(--motion-fast) var(--ease-feedback);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 8.5rem;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-activity);
  }

  .contact-submit {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .form-status {
    min-height: 1.25rem;
    opacity: 0.75;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }
</style>
