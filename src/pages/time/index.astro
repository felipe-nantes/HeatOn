---
import Page from '../../layouts/Page.astro';
import { team } from '../../content/site';
---

<Page
  title="Time — Heat On"
  description={team.body}
  eyebrow="PAGE 005 / TEAM"
  heading="Time"
  headline={team.headline}
  meta={[`${team.members.length} INTEGRANTES`]}
>
  <section class="section surface-cream" aria-label="Integrantes">
    <div class="container section-content">
      <p class="body-copy team-lede reveal reveal--body">{team.body}</p>

      <ol role="list" class="team-grid">
        {
          team.members.map((m) => (
            <li class="member reveal reveal--body">
              <a class="member-link" href={`/time/${m.id}`}>
                <figure class="member-figure">
                  <img
                    src={m.photo}
                    alt={m.alt}
                    width="640"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <span class="data member-num">{m.num}</span>
                <span class="member-name">{m.name}</span>
                <span class="member-role">{m.role}</span>
                <span class="data member-discipline">{m.discipline}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Page>

<style>
  .team-lede {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .team-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .member-link {
    display: grid;
    gap: 0.5rem;
    text-decoration: none;
  }

  .member-figure {
    margin: 0 0 1.25rem;
    overflow: hidden;
    background: rgba(14, 14, 16, 0.06);
  }

  .member-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
    transition:
      filter var(--motion-base) var(--ease-editorial),
      transform var(--motion-base) var(--ease-editorial);
  }

  @media (hover: hover) {
    .member-link:hover .member-figure img,
    .member-link:focus-visible .member-figure img {
      filter: grayscale(0) contrast(1);
      transform: scale(1.02);
    }
  }

  .member-num {
    padding-top: 0.9rem;
    border-top: 1px solid rgba(14, 14, 16, 0.16);
    opacity: 0.5;
    transition: color var(--motion-fast) var(--ease-feedback);
  }

  @media (hover: hover) {
    .member-link:hover .member-num,
    .member-link:focus-visible .member-num {
      color: var(--color-activity);
      opacity: 1;
    }
  }

  .member-name {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.15rem + 1vw, 1.875rem);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
  }

  .member-role {
    opacity: 0.8;
  }

  .member-discipline {
    margin-top: 0.35rem;
    color: var(--color-measurement);
    opacity: 0.9;
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .member-figure img {
      transition: none;
    }
  }
</style>
