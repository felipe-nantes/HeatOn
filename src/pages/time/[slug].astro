---
import Page from '../../layouts/Page.astro';
import { team } from '../../content/site';

export function getStaticPaths() {
  return team.members.map((member, i) => ({
    params: { slug: member.id },
    props: {
      member,
      next: team.members[(i + 1) % team.members.length],
    },
  }));
}

const { member, next } = Astro.props;

// Só o que a empresa informou. Biografia, formação e projetos por pessoa
// ainda não foram fornecidos e não serão presumidos aqui.
---

<Page
  title={`${member.name} — Heat On`}
  description={`${member.name} — ${member.role} na Heat On.`}
  eyebrow={`TEAM ${member.num} / ${member.discipline}`}
  heading={member.name}
  headline={member.role}
>
  <section class="section surface-cream" aria-label={`Perfil de ${member.name}`}>
    <div class="container section-content profile">
      <figure class="profile-figure reveal">
        <img
          src={member.photo}
          alt={member.alt}
          width="640"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="profile-body">
        <dl class="profile-rows reveal reveal--body">
          <div class="row">
            <dt class="data">NOME</dt>
            <dd>{member.name}</dd>
          </div>
          <div class="row">
            <dt class="data">FUNÇÃO</dt>
            <dd>{member.role}</dd>
          </div>
          <div class="row">
            <dt class="data">DISCIPLINA</dt>
            <dd>{member.discipline}</dd>
          </div>
          <div class="row">
            <dt class="data">TIME</dt>
            <dd>{member.num} / {team.members.length}</dd>
          </div>
        </dl>

        <p class="body-copy team-context reveal reveal--body">{team.body}</p>

        <div class="profile-actions reveal">
          <a class="pill" href="/time">
            Todo o time
            <span class="pill-plus" aria-hidden="true">+</span>
          </a>
          <a class="pill" href={`/time/${next.id}`}>
            {next.name}
            <span class="pill-plus" aria-hidden="true">+</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .profile {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .profile-figure {
    margin: 0;
    overflow: hidden;
    background: rgba(14, 14, 16, 0.06);
  }

  .profile-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .profile-rows {
    display: grid;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(90px, 150px) 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid rgba(14, 14, 16, 0.16);
  }

  .row:last-child {
    border-bottom: 1px solid rgba(14, 14, 16, 0.16);
  }

  .row dt {
    opacity: 0.5;
  }

  .row dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.96rem + 0.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
  }

  .team-context {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    opacity: 0.8;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 1024px) {
    .profile {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }
</style>
