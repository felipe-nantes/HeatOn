---
import Page from '../../layouts/Page.astro';
import { team, affiliation } from '../../content/site';
import { projectPages } from '../../content/pages';
import { sectors } from '../../content/sectors';

export function getStaticPaths() {
  return team.members.map((member, i) => ({
    params: { slug: member.id },
    props: {
      member,
      next: team.members[(i + 1) % team.members.length],
    },
  }));
}

const { member, next } = Astro.props;

const worked = member.projects
  .map((slug) => projectPages.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Setores derivados: quais disciplinas os projetos desta pessoa atravessam.
// É inferência a partir da área declarada de cada projeto, não uma
// especialidade autodeclarada.
const memberSectors = sectors.filter((sector) =>
  sector.projects.some((slug) => member.projects.includes(slug))
);

// Colegas por projeto: quem mais atuou em cada um (derivado dos dados).
const colleaguesOf = (slug: string) =>
  team.members.filter((m) => m.id !== member.id && m.projects.includes(slug));

// Quem divide a mesma função — usado para situar a ênfase de cada um.
const peers = team.members.filter(
  (m) => m.id !== member.id && m.discipline === member.discipline
);
---

<Page
  title={`${member.name} — Heat On`}
  description={`${member.name} — ${member.role} na Heat On.`}
  eyebrow={`TEAM ${member.num} / ${member.discipline}`}
  heading={member.name}
  headline={member.role}
  meta={[member.institution, `${worked.length} PROJETOS`]}
>
  <section class="section surface-cream" aria-label={`Perfil de ${member.shortName}`}>
    <div class="container section-content profile">
      <figure class="profile-figure reveal">
        <img
          src={member.photo}
          alt={member.alt}
          width="640"
          height="800"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="data profile-readout" aria-hidden="true">
          <span>MEMBER / {member.num}·{String(team.members.length).padStart(2, '0')}</span>
          <span>PROJECTS / {String(worked.length).padStart(2, '0')}</span>
          <span>SECTORS / {String(memberSectors.length).padStart(2, '0')}</span>
          <span class="readout-on">STATUS / ATIVO</span>
        </figcaption>
      </figure>

      <div class="profile-body">
        <dl class="profile-rows reveal reveal--body">
          <div class="row">
            <dt class="data">FUNÇÃO</dt>
            <dd>{member.role}</dd>
          </div>
          <div class="row">
            <dt class="data">ÊNFASE</dt>
            <dd>{member.focus}</dd>
          </div>
          <div class="row">
            <dt class="data">INSTITUIÇÃO</dt>
            <dd>{member.institution}</dd>
          </div>
          <div class="row">
            <dt class="data">GRUPO</dt>
            <dd>{affiliation.acronym}</dd>
          </div>
          {
            member.getsListing && (
              <div class="row">
                <dt class="data">NO GETS</dt>
                <dd>
                  {member.getsListing.role} — {member.getsListing.unit}
                </dd>
              </div>
            )
          }
          <div class="row">
            <dt class="data">PROJETOS</dt>
            <dd>{String(worked.length).padStart(2, '0')} / {String(projectPages.length).padStart(2, '0')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section surface-deep" aria-label={`O papel de ${member.shortName} no time`}>
    <div class="container section-content essay-section">
      <p class="data essay-label reveal reveal--label">{member.essay.label}</p>

      <div class="essay-body">
        {member.essay.paragraphs.map((paragraph, i) => (
          <p class:list={['body-copy', i === 0 ? 'essay-lede' : 'essay-text', 'reveal', 'reveal--body']}>
            {paragraph}
          </p>
        ))}
      </div>

      {
        peers.length > 0 && (
          <p class="body-copy peer-note reveal reveal--body">
            {member.shortName} divide a mesma função com{' '}
            {peers.map((p) => p.shortName).join(' e ')} — o que muda é a ênfase do dia a dia.
          </p>
        )
      }
    </div>
  </section>

  <section class="section surface-cream" aria-label={`Atuação de ${member.shortName}`}>
    <div class="container section-content">
      <div class="context-grid">
        <div class="context-block reveal reveal--body">
          <p class="data light-label">GRUPO DE PESQUISA</p>
          <p class="group-name">{affiliation.acronym}</p>
          <p class="group-full">{affiliation.name}</p>
          <p class="data group-meta">
            {affiliation.institution} / DESDE {affiliation.since}
          </p>
          <p class="body-copy group-note">{affiliation.scope}</p>

          <ul role="list" class="group-areas">
            {affiliation.areas.map((area) => <li>{area}</li>)}
          </ul>

          <a class="seq-full-link group-link" href={affiliation.url} target="_blank" rel="noopener">
            SITE DO GRUPO +
          </a>
        </div>

        <div class="context-block reveal reveal--body">
          <p class="data light-label">SETORES ATRAVESSADOS</p>
          <ul role="list" class="sector-tags">
            {memberSectors.map((sector) => (
              <li>
                <a class="sector-tag" href={`/setores/${sector.slug}`}>
                  {sector.title}
                </a>
              </li>
            ))}
          </ul>
          <p class="data derived-note">
            Derivado da área declarada dos projetos em que atuou.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-deep" aria-label={`Projetos de ${member.shortName}`}>
    <div class="container section-content">
      <p class="data dark-label reveal reveal--label">PROJETOS EM QUE ATUOU</p>
      <ol role="list" class="proj-list">
        {
          worked.map((p) => (
            <li class="proj-row reveal">
              <a class="proj-link" href={`/projetos/${p.slug}`}>
                <span class="data proj-num">{p.num}</span>
                <span class="proj-copy">
                  <span class="proj-title">{p.title}</span>
                  <span class="data proj-area">{p.area}</span>
                  {colleaguesOf(p.slug).length > 0 && (
                    <span class="data proj-with">
                      COM {colleaguesOf(p.slug).map((c) => c.shortName).join(' · ')}
                    </span>
                  )}
                </span>
                <span class="data proj-plus" aria-hidden="true">+</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="profile-actions reveal">
        <a class="pill" href="/time">
          Todo o time
          <span class="pill-plus" aria-hidden="true">+</span>
        </a>
        <a class="pill" href={`/time/${next.id}`}>
          {next.shortName}
          <span class="pill-plus" aria-hidden="true">+</span>
        </a>
      </div>
    </div>
  </section>
</Page>

<style>
  .profile {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .profile-figure {
    margin: 0;
    overflow: hidden;
    background: rgba(14, 14, 16, 0.06);
  }

  .profile-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .profile-rows {
    display: grid;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(90px, 150px) 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid rgba(14, 14, 16, 0.16);
  }

  .row:last-child {
    border-bottom: 1px solid rgba(14, 14, 16, 0.16);
  }

  .row dt {
    opacity: 0.5;
  }

  .row dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.96rem + 0.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
  }

  .profile-readout {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(14, 14, 16, 0.16);
    opacity: 0.65;
  }

  .readout-on {
    color: var(--color-activity);
    opacity: 1;
  }

  /* ---------- Seção "O papel no time" (superfície deep) ---------- */
  .essay-section {
    max-width: 68ch;
  }

  .essay-label {
    color: var(--color-activity);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .essay-body {
    display: grid;
    gap: 1.1rem;
  }

  .essay-lede {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem);
    font-weight: 400;
    letter-spacing: var(--tracking-heading);
    line-height: 1.35;
    max-width: none;
  }

  .essay-text {
    max-width: none;
    opacity: 0.86;
  }

  .peer-note {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-top: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 1px solid rgba(255, 244, 230, 0.14);
    opacity: 0.65;
    max-width: none;
  }

  /* ---------- Rótulos por superfície ---------- */
  .light-label {
    color: var(--color-structure);
    opacity: 0.62;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .dark-label {
    color: var(--color-measurement);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .context-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid rgba(14, 14, 16, 0.14);
  }

  .group-name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    font-weight: 300;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--color-activity);
  }

  .group-full {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.96rem + 0.5vw, 1.375rem);
    font-weight: 400;
    letter-spacing: var(--tracking-heading);
  }

  .group-meta {
    margin-top: 0.7rem;
    opacity: 0.6;
  }

  .group-note {
    margin-top: 1rem;
    opacity: 0.7;
    max-width: 44ch;
  }

  .group-areas {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(14, 14, 16, 0.14);
    font-size: 0.9375rem;
    opacity: 0.72;
  }

  .group-link {
    display: inline-block;
    margin-top: 1.25rem;
  }

  .sector-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .sector-tag {
    display: inline-block;
    padding: 0.55em 1.1em;
    border: 1px solid rgba(14, 14, 16, 0.24);
    border-radius: 999px;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-data);
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color var(--motion-fast) var(--ease-feedback), color var(--motion-fast) var(--ease-feedback);
  }

  .sector-tag:hover,
  .sector-tag:focus-visible {
    color: var(--color-activity);
    border-color: var(--color-activity);
  }

  .derived-note {
    margin-top: 1.1rem;
    opacity: 0.45;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  @media (min-width: 1024px) {
    .context-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .proj-list {
    display: grid;
  }

  .proj-row {
    border-top: 1px solid rgba(255, 244, 230, 0.14);
  }

  .proj-row:last-child {
    border-bottom: 1px solid rgba(255, 244, 230, 0.14);
  }

  .proj-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding-block: clamp(1.1rem, 2.4vw, 1.7rem);
    text-decoration: none;
  }

  .proj-num {
    opacity: 0.5;
  }

  .proj-copy {
    display: grid;
    gap: 0.4rem;
  }

  .proj-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.625rem);
    font-weight: 400;
    letter-spacing: var(--tracking-heading);
  }

  .proj-area {
    opacity: 0.5;
  }

  .proj-with {
    color: var(--color-measurement);
    opacity: 0.75;
  }

  .proj-plus {
    opacity: 0.4;
    transition: color var(--motion-fast) var(--ease-feedback), opacity var(--motion-fast) var(--ease-feedback);
  }

  @media (hover: hover) {
    .proj-link:hover .proj-plus,
    .proj-link:focus-visible .proj-plus {
      color: var(--color-activity);
      opacity: 1;
    }
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 1024px) {
    .profile {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }
</style>
