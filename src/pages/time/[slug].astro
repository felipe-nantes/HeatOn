---
import Page from '../../layouts/Page.astro';
import { team, affiliation } from '../../content/site';
import { projectPages } from '../../content/pages';
import { sectors } from '../../content/sectors';

export function getStaticPaths() {
  return team.members.map((member, i) => ({
    params: { slug: member.id },
    props: {
      member,
      next: team.members[(i + 1) % team.members.length],
    },
  }));
}

const { member, next } = Astro.props;

const worked = member.projects
  .map((slug) => projectPages.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Setores derivados: quais disciplinas os projetos desta pessoa atravessam.
// É inferência a partir da área declarada de cada projeto, não uma
// especialidade autodeclarada.
const memberSectors = sectors.filter((sector) =>
  sector.projects.some((slug) => member.projects.includes(slug))
);

// Quem divide a mesma função — usado para situar a ênfase de cada um.
const peers = team.members.filter(
  (m) => m.id !== member.id && m.discipline === member.discipline
);
---

<Page
  title={`${member.name} — Heat On`}
  description={`${member.name} — ${member.role} na Heat On.`}
  eyebrow={`TEAM ${member.num} / ${member.discipline}`}
  heading={member.name}
  headline={member.role}
  meta={[member.institution, `${worked.length} PROJETOS`]}
>
  <section class="section surface-cream" aria-label={`Perfil de ${member.shortName}`}>
    <div class="container section-content profile">
      <figure class="profile-figure reveal">
        <img
          src={member.photo}
          alt={member.alt}
          width="640"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="profile-body">
        <dl class="profile-rows reveal reveal--body">
          <div class="row">
            <dt class="data">FUNÇÃO</dt>
            <dd>{member.role}</dd>
          </div>
          <div class="row">
            <dt class="data">ÊNFASE</dt>
            <dd>{member.focus}</dd>
          </div>
          <div class="row">
            <dt class="data">INSTITUIÇÃO</dt>
            <dd>{member.institution}</dd>
          </div>
          <div class="row">
            <dt class="data">GRUPO</dt>
            <dd>{affiliation.acronym}</dd>
          </div>
          <div class="row">
            <dt class="data">PROJETOS</dt>
            <dd>{String(worked.length).padStart(2, '0')} / {String(projectPages.length).padStart(2, '0')}</dd>
          </div>
        </dl>

        {
          peers.length > 0 && (
            <p class="body-copy peer-note reveal reveal--body">
              {member.shortName} divide a mesma função com{' '}
              {peers.map((p) => p.shortName).join(' e ')}; o que muda entre eles é a
              ênfase do dia a dia.
            </p>
          )
        }

        <p class="body-copy team-context reveal reveal--body">{team.body}</p>
      </div>
    </div>
  </section>

  <section class="section surface-deep" aria-label={`Atuação de ${member.shortName}`}>
    <div class="container section-content">
      <div class="context-grid">
        <div class="context-block reveal reveal--body">
          <p class="data dark-label">GRUPO DE ESTUDOS</p>
          <p class="group-name">{affiliation.acronym}</p>
          <p class="group-full">{affiliation.name}</p>
          <p class="body-copy group-note">{affiliation.note}</p>
        </div>

        <div class="context-block reveal reveal--body">
          <p class="data dark-label">SETORES ATRAVESSADOS</p>
          <ul role="list" class="sector-tags">
            {memberSectors.map((sector) => (
              <li>
                <a class="sector-tag" href={`/setores/${sector.slug}`}>
                  {sector.title}
                </a>
              </li>
            ))}
          </ul>
          <p class="data derived-note">
            Derivado da área declarada dos projetos em que atuou.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-deep" aria-label={`Projetos de ${member.shortName}`}>
    <div class="container section-content">
      <p class="data dark-label reveal reveal--label">PROJETOS EM QUE ATUOU</p>
      <ol role="list" class="proj-list">
        {
          worked.map((p) => (
            <li class="proj-row reveal">
              <a class="proj-link" href={`/projetos/${p.slug}`}>
                <span class="data proj-num">{p.num}</span>
                <span class="proj-copy">
                  <span class="proj-title">{p.title}</span>
                  <span class="data proj-area">{p.area}</span>
                </span>
                <span class="data proj-plus" aria-hidden="true">+</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="profile-actions reveal">
        <a class="pill" href="/time">
          Todo o time
          <span class="pill-plus" aria-hidden="true">+</span>
        </a>
        <a class="pill" href={`/time/${next.id}`}>
          {next.shortName}
          <span class="pill-plus" aria-hidden="true">+</span>
        </a>
      </div>
    </div>
  </section>
</Page>

<style>
  .profile {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .profile-figure {
    margin: 0;
    overflow: hidden;
    background: rgba(14, 14, 16, 0.06);
  }

  .profile-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .profile-rows {
    display: grid;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(90px, 150px) 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid rgba(14, 14, 16, 0.16);
  }

  .row:last-child {
    border-bottom: 1px solid rgba(14, 14, 16, 0.16);
  }

  .row dt {
    opacity: 0.5;
  }

  .row dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.96rem + 0.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
  }

  .peer-note {
    margin-top: clamp(1.5rem, 3.5vw, 2.25rem);
    opacity: 0.75;
  }

  .team-context {
    margin-top: 1rem;
    opacity: 0.75;
  }

  .dark-label {
    color: var(--color-measurement);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .context-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid rgba(255, 244, 230, 0.14);
  }

  .group-name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    font-weight: 300;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--color-activity);
  }

  .group-full {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.96rem + 0.5vw, 1.375rem);
    font-weight: 400;
    letter-spacing: var(--tracking-heading);
  }

  .group-note {
    margin-top: 1rem;
    opacity: 0.7;
    max-width: 40ch;
  }

  .sector-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .sector-tag {
    display: inline-block;
    padding: 0.55em 1.1em;
    border: 1px solid rgba(255, 244, 230, 0.24);
    border-radius: 999px;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-data);
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color var(--motion-fast) var(--ease-feedback), color var(--motion-fast) var(--ease-feedback);
  }

  .sector-tag:hover,
  .sector-tag:focus-visible {
    color: var(--color-activity);
    border-color: var(--color-activity);
  }

  .derived-note {
    margin-top: 1.1rem;
    opacity: 0.45;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  @media (min-width: 1024px) {
    .context-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .proj-list {
    display: grid;
  }

  .proj-row {
    border-top: 1px solid rgba(255, 244, 230, 0.14);
  }

  .proj-row:last-child {
    border-bottom: 1px solid rgba(255, 244, 230, 0.14);
  }

  .proj-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding-block: clamp(1.1rem, 2.4vw, 1.7rem);
    text-decoration: none;
  }

  .proj-num {
    opacity: 0.5;
  }

  .proj-copy {
    display: grid;
    gap: 0.4rem;
  }

  .proj-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.625rem);
    font-weight: 400;
    letter-spacing: var(--tracking-heading);
  }

  .proj-area {
    opacity: 0.5;
  }

  .proj-plus {
    opacity: 0.4;
    transition: color var(--motion-fast) var(--ease-feedback), opacity var(--motion-fast) var(--ease-feedback);
  }

  @media (hover: hover) {
    .proj-link:hover .proj-plus,
    .proj-link:focus-visible .proj-plus {
      color: var(--color-activity);
      opacity: 1;
    }
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 1024px) {
    .profile {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }
</style>
