---
import Page from '../layouts/Page.astro';
import { capabilities } from '../content/site';
import { competencies, verticals } from '../content/pages';
---

<Page
  title="Capacidades — Heat On"
  description="Software sob medida, engenharia de dados, inteligência artificial, imagem médica, realidade virtual e automação aplicados à saúde."
  eyebrow="PAGE 002 / CAPABILITIES"
  heading="Capacidades"
  headline="O que a Heat On constrói, do dado bruto ao sistema em uso."
  meta={[`${capabilities.items.length} CAPACIDADES`, `${verticals.length} VERTICAIS`]}
>
  <section class="section surface-deep" aria-label="Capacidades">
    <div class="container section-content">
      <ol role="list" class="cap-list">
        {
          capabilities.items.map((item, i) => (
            <li class="cap reveal">
              <span class="data cap-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="cap-name">{item}</span>
              <span class="data cap-plus" aria-hidden="true">+</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section surface-cream" aria-label="Competências consolidadas">
    <div class="container section-content">
      <p class="data block-label reveal reveal--label">COMPETÊNCIAS CONSOLIDADAS</p>
      <div class="comp-grid">
        {
          competencies.map((group) => (
            <div class="comp reveal reveal--body">
              <p class="data comp-label">{group.label}</p>
              <ul role="list" class="comp-items">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section surface-deep" aria-label="Verticais de atuação">
    <div class="container section-content">
      <p class="data block-label block-label--dark reveal reveal--label">
        VERTICAIS DE ATUAÇÃO
      </p>
      <ul role="list" class="vert-list reveal">
        {verticals.map((v) => <li class="vert">{v}</li>)}
      </ul>
    </div>
  </section>
</Page>

<style>
  .cap-list {
    display: grid;
  }

  .cap {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    padding-block: clamp(0.9rem, 2vw, 1.4rem);
    border-top: 1px solid rgba(255, 244, 230, 0.14);
  }

  .cap:last-child {
    border-bottom: 1px solid rgba(255, 244, 230, 0.14);
  }

  .cap-num {
    opacity: 0.5;
  }

  .cap-name {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.75rem);
    font-weight: 400;
    letter-spacing: var(--tracking-heading);
  }

  .cap-plus {
    margin-left: auto;
    opacity: 0.3;
    transition: color var(--motion-fast) var(--ease-feedback), opacity var(--motion-fast) var(--ease-feedback);
  }

  @media (hover: hover) {
    .cap:hover .cap-plus,
    .cap:hover .cap-num {
      color: var(--color-activity);
      opacity: 1;
    }
  }

  .block-label {
    color: var(--color-structure);
    opacity: 0.55;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .block-label--dark {
    color: var(--color-measurement);
    opacity: 0.9;
  }

  .comp-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .comp-label {
    color: var(--color-activity);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(14, 14, 16, 0.16);
    margin-bottom: 1rem;
  }

  .comp-items {
    display: grid;
    gap: 0.4rem;
    opacity: 0.82;
  }

  .vert-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .vert {
    padding: 0.55em 1.1em;
    border: 1px solid rgba(255, 244, 230, 0.24);
    border-radius: 999px;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-data);
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .comp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .comp-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
